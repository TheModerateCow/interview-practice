 {"name": "budgets_and_burners", "steps": [
  {"new": "SloMonitor", "args": []},
  {"call": "add_service", "args": ["checkout"], "expect": true},
  {"call": "ingest", "args": ["checkout", 0, [100, 100, 100, 100], [0, 3, 1, 0]], "expect": true},
  {"call": "add_service", "args": ["search"], "expect": true},
  {"call": "ingest", "args": ["search", 0, [50, 50, 50, 50], [2, 2, 0, 0]], "expect": true},
  {"call": "set_budget", "args": ["checkout", 10000], "expect": true},
  {"call": "set_budget", "args": ["search", 20000], "expect": true},
  {"call": "set_budget", "args": ["payments", 5000], "expect": false},
  {"call": "budget_left", "args": ["checkout", 0, 3], "expect": 0},
  {"call": "budget_left", "args": ["checkout", 1, 1], "expect": -2},
  {"call": "budget_left", "args": ["search", 2, 3], "expect": 2},
  {"call": "over_budget", "args": [1, 2], "expect": ["search:40000", "checkout:15000"]},
  {"call": "over_budget", "args": [2, 3], "expect": ["search:26666", "checkout:13333"]},
  {"call": "over_budget", "args": [3, 2], "expect": []}
 ]},
 {"name": "budget_left_rounds_allowance_down", "steps": [
  {"new": "SloMonitor", "args": []},
  {"call": "add_service", "args": ["api"], "expect": true},
  {"call": "ingest", "args": ["api", 0, [150, 50, 99], [0, 0, 1]], "expect": true},
  {"call": "budget_left", "args": ["api", 0, 2], "expect": null},
  {"call": "set_budget", "args": ["api", 10000], "expect": true},
  {"call": "budget_left", "args": ["api", 0, 0], "expect": 1},
  {"call": "budget_left", "args": ["api", 0, 1], "expect": 2},
  {"call": "budget_left", "args": ["api", 0, 2], "expect": 1},
  {"call": "budget_left", "args": ["api", 2, 2], "expect": -1},
  {"call": "budget_left", "args": ["api", 3, 50], "expect": 0},
  {"call": "set_budget", "args": ["api", 20000], "expect": true},
  {"call": "budget_left", "args": ["api", 0, 2], "expect": 4},
  {"call": "budget_left", "args": ["web", 0, 2], "expect": null}
 ]},
 {"name": "exactly_on_budget_is_not_over", "steps": [
