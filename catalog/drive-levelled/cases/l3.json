    "args": [
     "ben",
     "/missing.txt",
     "/ben/x.txt"
    ],
    "expect": -1
   },
   {
    "call": "copy_file_by",
    "args": [
     "ben",
     "/ben/map.png",
     "/ana/report.pdf"
    ],
    "expect": -1
   },
   {
    "call": "copy_file_by",
    "args": [
     "zoe",
     "/public/map.png",
     "/zoe/map.png"
    ],
    "expect": -1
   },
   {
    "call": "copy_file_by",
    "args": [
     "ana",
     "/ben/map.png",
     "/ana/map.png"
    ],
    "expect": 50
   },
   {
    "call": "remaining",
    "args": [
     "ben"
    ],
    "expect": 100
   },
   {
    "call": "remaining",
    "args": [
     "ana"
    ],
    "expect": 50
