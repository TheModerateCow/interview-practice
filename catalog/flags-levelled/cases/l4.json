 {
  "name": "history_scheduled_at_due_time",
  "steps": [
   {
    "new": "FlagService",
    "args": []
   },
   {
    "call": "create_flag",
    "args": [
     1,
     "launch"
    ],
    "expect": true
   },
   {
    "call": "set_enabled",
    "args": [
     2,
     "launch",
     "prod",
     false
    ],
    "expect": true
   },
   {
    "call": "schedule_change",
    "args": [
     3,
     "launch",
     "prod",
     true,
     20
    ],
    "expect": "s1"
   },
   {
    "call": "schedule_change",
    "args": [
     4,
     "launch",
     "prod",
     false,
     25
    ],
    "expect": "s2"
   },
   {
    "call": "cancel_schedule",
    "args": [
     5,
     "s2"
    ],
    "expect": true
   },
   {
    "call": "set_enabled",
    "args": [
     30,
     "launch",
     "prod",
     false
    ],
    "expect": true
   },
   {
    "call": "history",
    "args": [
     31,
     "launch",
     "prod"
    ],
    "expect": [
     "2:off",
     "20:on",
     "30:off"
    ]
   }
  ]
 },
