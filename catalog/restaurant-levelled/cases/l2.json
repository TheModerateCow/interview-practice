[
 {
  "name": "waitlist_skips_parties_that_dont_fit",
  "steps": [
   {
    "new": "Restaurant",
    "args": []
   },
   {
    "call": "add_table",
    "args": [
     1,
     "T1",
     2
    ],
    "expect": true
   },
   {
    "call": "add_table",
    "args": [
     1,
     "T2",
     4
    ],
    "expect": true
   },
   {
    "call": "book",
    "args": [
     2,
     "maya",
     4,
     1140
    ],
    "expect": "r1"
   },
   {
    "call": "book",
    "args": [
     3,
     "leo",
     2,
     1140
    ],
    "expect": "r2"
   },
   {
    "call": "join_waitlist",
    "args": [
     4,
     "ana",
     4,
     1140
    ],
    "expect": true
   },
   {
    "call": "join_waitlist",
    "args": [
     5,
     "bo",
     2,
     1140
    ],
    "expect": true
   },
   {
    "call": "waitlist",
    "args": [
     6,
     1140
    ],
    "expect": [
     "ana(4)",
     "bo(2)"
    ]
   },
   {
    "call": "cancel",
    "args": [
     7,
     "r2"
    ],
    "expect": true
   },
   {
    "call": "table_of",
    "args": [
     8,
     "r3"
    ],
    "expect": "T1"
   },
   {
    "call": "party_at",
    "args": [
     8,
     "T1",
     1140
    ],
    "expect": "bo"
   },
   {
    "call": "waitlist",
    "args": [
     9,
     1140
    ],
    "expect": [
     "ana(4)"
    ]
   }
  ]
 },
 {
