[
 {
  "name": "priority_example",
  "steps": [
   {
    "new": "RiskScreen",
    "args": []
   },
   {
    "call": "block",
    "args": [
     1,
     "merchant",
     "m-casino"
    ],
    "expect": true
   },
   {
    "call": "add_velocity_rule",
    "args": [
     2,
     "v-count",
     "count",
     1,
     600
    ],
    "expect": true
   },
   {
    "call": "allow",
    "args": [
     3,
     "card",
     "4111",
     5
    ],
    "expect": true
   },
   {
    "call": "screen",
    "args": [
     10,
     "t1",
     "4111",
     "m-casino",
     1000,
     "GB"
    ],
    "expect": "approve"
   },
   {
    "call": "explain",
    "args": [
     11,
     "t1"
    ],
    "expect": "allow:card:4111"
   },
   {
    "call": "set_priority",
    "args": [
     12,
     "block:merchant:m-casino",
     9
    ],
    "expect": true
   },
   {
    "call": "screen",
    "args": [
     13,
     "t2",
     "4111",
     "m-casino",
     1000,
     "GB"
    ],
    "expect": "decline"
   },
   {
    "call": "explain",
    "args": [
     14,
     "t2"
    ],
    "expect": "block:merchant:m-casino"
   },
   {
    "call": "screen",
    "args": [
     15,
     "t3",
     "5500",
     "m-shoes",
     1000,
     "GB"
    ],
    "expect": "approve"
   },
   {
    "call": "screen",
    "args": [
     16,
     "t4",
     "5500",
     "m-shoes",
     1000,
     "GB"
    ],
    "expect": "review"
   },
   {
    "call": "explain",
    "args": [
     17,
     "t3"
    ],
    "expect": ""
   },
   {
    "call": "explain",
    "args": [
     18,
     "t4"
    ],
    "expect": "v-count"
   }
  ]
 },
