[
 {
  "name": "review_queue_example",
  "steps": [
   {
    "new": "RiskScreen",
    "args": []
   },
   {
    "call": "add_velocity_rule",
    "args": [
     1,
     "v-amount",
     "amount",
     50000,
     60
    ],
    "expect": true
   },
   {
    "call": "screen",
    "args": [
     10,
     "t1",
     "4111",
     "m-tv",
     80000,
     "GB"
    ],
    "expect": "review"
   },
   {
    "call": "screen",
    "args": [
     20,
     "t2",
     "5500",
     "m-tv",
     70000,
     "GB"
    ],
    "expect": "review"
   },
   {
    "call": "pending_reviews",
    "args": [
     30
    ],
    "expect": [
     "t1",
     "t2"
    ]
   },
   {
    "call": "decline_review",
    "args": [
     40,
     "t1",
     100
    ],
    "expect": true
   },
   {
    "call": "decision",
    "args": [
     41,
     "t1"
    ],
    "expect": "decline"
   },
   {
    "call": "explain",
    "args": [
     41,
     "t1"
    ],
    "expect": "analyst"
   },
   {
    "call": "screen",
    "args": [
     50,
     "t3",
     "4111",
     "m-books",
     1000,
     "GB"
    ],
    "expect": "decline"
   },
   {
    "call": "explain",
    "args": [
     51,
     "t3"
    ],
    "expect": "block:card:4111"
   },
   {
    "call": "approve_review",
    "args": [
     60,
     "t2"
    ],
    "expect": true
   },
   {
    "call": "pending_reviews",
    "args": [
     70
    ],
    "expect": []
   },
   {
    "call": "screen",
    "args": [
     140,
     "t4",
     "4111",
     "m-books",
     1000,
     "GB"
    ],
    "expect": "approve"
   }
  ]
 },
