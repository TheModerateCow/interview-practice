[
 {
  "name": "blocklist_example",
  "steps": [
   {
    "new": "RiskScreen",
    "args": []
   },
   {
    "call": "block",
    "args": [
     1,
     "card",
     "4111"
    ],
    "expect": true
   },
   {
    "call": "block",
    "args": [
     2,
     "card",
     "4111"
    ],
    "expect": false
   },
   {
    "call": "block",
    "args": [
     3,
     "bank",
     "b-1"
    ],
    "expect": false
   },
   {
    "call": "screen",
    "args": [
     4,
     "t1",
     "4111",
     "m-shoes",
     2500,
     "GB"
    ],
    "expect": "decline"
   },
   {
    "call": "screen",
    "args": [
     5,
     "t2",
     "5500",
     "m-shoes",
     2500,
     "GB"
    ],
    "expect": "approve"
   },
   {
    "call": "block",
    "args": [
     6,
     "country",
     "ZZ"
    ],
    "expect": true
   },
   {
    "call": "screen",
    "args": [
     7,
     "t3",
     "5500",
     "m-books",
     900,
     "ZZ"
    ],
    "expect": "decline"
   },
   {
    "call": "unblock",
    "args": [
     8,
     "card",
     "4111"
    ],
    "expect": true
   },
   {
    "call": "screen",
    "args": [
     9,
     "t4",
     "4111",
     "m-books",
     1200,
     "GB"
    ],
    "expect": "approve"
   },
   {
    "call": "decision",
    "args": [
     10,
     "t1"
    ],
    "expect": "decline"
   },
   {
    "call": "screen",
    "args": [
     11,
     "t4",
     "5500",
     "m-books",
     1200,
     "GB"
    ],
    "expect": ""
   }
  ]
 },
