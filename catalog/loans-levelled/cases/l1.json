[
 {
  "name": "schedule_and_amount_due",
  "steps": [
   {
    "new": "Lender",
    "args": []
   },
   {
    "call": "originate",
    "args": [
     1,
     "car",
     100000,
     3,
     150
    ],
    "expect": true
   },
   {
    "call": "originate",
    "args": [
     2,
     "car",
     5000,
     1,
     0
    ],
    "expect": false
   },
   {
    "call": "originate",
    "args": [
     3,
     "bike",
     100100,
     2,
     50
    ],
    "expect": true
   },
   {
    "call": "schedule",
    "args": [
     4,
     "car"
    ],
    "expect": [
     "31:34833",
     "61:34833",
     "91:34834"
    ]
   },
   {
    "call": "schedule",
    "args": [
     4,
     "bike"
    ],
    "expect": [
     "33:50551",
     "63:50551"
    ]
   },
   {
    "call": "amount_due",
    "args": [
     30,
     "car"
    ],
    "expect": 0
   },
   {
    "call": "amount_due",
    "args": [
     31,
     "car"
    ],
    "expect": 34833
   },
   {
    "call": "amount_due",
    "args": [
     70,
     "car"
    ],
    "expect": 69666
   }
  ]
 },
 {
  "name": "originate_rejects_bad_loans",
  "steps": [
   {
    "new": "Lender",
    "args": []
   },
   {
    "call": "originate",
    "args": [
     1,
     "a",
     0,
     3,
     100
    ],
    "expect": false
   },
   {
    "call": "originate",
    "args": [
     2,
     "a",
     -500,
     3,
     100
    ],
    "expect": false
   },
   {
    "call": "originate",
    "args": [
     3,
     "a",
     1000,
     0,
     100
    ],
    "expect": false
   },
   {
    "call": "originate",
    "args": [
     4,
     "a",
     1000,
     -2,
     100
    ],
    "expect": false
   },
   {
    "call": "originate",
    "args": [
     5,
     "a",
     1000,
     2,
     -1
    ],
    "expect": false
   },
   {
    "call": "schedule",
    "args": [
     6,
     "a"
    ],
    "expect": []
   },
   {
    "call": "amount_due",
    "args": [
     6,
     "a"
    ],
    "expect": -1
   },
   {
    "call": "originate",
    "args": [
     7,
     "a",
     1000,
     2,
     0
    ],
    "expect": true
   },
   {
    "call": "schedule",
    "args": [
     8,
     "a"
    ],
    "expect": [
     "37:500",
     "67:500"
    ]
   },
   {
    "call": "originate",
    "args": [
     9,
     "a",
     2000,
     1,
     0
    ],
    "expect": false
   },
   {
    "call": "schedule",
    "args": [
     10,
     "a"
    ],
    "expect": [
     "37:500",
     "67:500"
    ]
   },
   {
    "call": "schedule",
    "args": [
     10,
     "zzz"
    ],
    "expect": []
   },
   {
    "call": "amount_due",
    "args": [
     10,
     "zzz"
    ],
    "expect": -1
   }
  ]
 },
 {
  "name": "principal_remainder_goes_to_last",
  "steps": [
   {
    "new": "Lender",
    "args": []
   },
   {
    "call": "originate",
    "args": [
     1,
     "small",
     100,
     7,
     0
    ],
    "expect": true
   },
   {
    "call": "schedule",
    "args": [
     2,
     "small"
    ],
    "expect": [
     "31:14",
     "61:14",
     "91:14",
     "121:14",
     "151:14",
     "181:14",
     "211:16"
    ]
   },
   {
    "call": "originate",
    "args": [
     3,
     "tiny",
     2,
     3,
     0
    ],
    "expect": true
   },
   {
    "call": "schedule",
    "args": [
     4,
     "tiny"
    ],
    "expect": [
     "33:0",
     "63:0",
     "93:2"
    ]
   },
   {
    "call": "originate",
    "args": [
     5,
     "even",
     90000,
     3,
     0
    ],
    "expect": true
   },
   {
    "call": "schedule",
    "args": [
     6,
     "even"
    ],
    "expect": [
     "35:30000",
     "65:30000",
     "95:30000"
    ]
   }
  ]
 },
