    "call": "refund",
    "args": [
     6,
     "a1",
     4000
    ],
    "expect": false
   },
   {
    "call": "refund",
    "args": [
     7,
     "a1",
     3500
    ],
    "expect": true
   },
   {
    "call": "balance",
    "args": [
     8,
     "c1"
    ],
    "expect": 0
   },
   {
    "call": "available",
    "args": [
     8,
     "c1"
    ],
    "expect": 20000
   },
   {
    "call": "statement",
    "args": [
     8,
     "c1"
    ],
    "expect": [
     "3:a1:charge:6000",
     "5:a1:refund:2500",
     "7:a1:refund:3500"
    ]
   }
  ]
 },
