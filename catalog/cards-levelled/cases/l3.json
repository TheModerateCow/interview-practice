    "args": [
     1,
     "c1",
     20000
    ],
    "expect": true
   },
   {
    "call": "authorize",
    "args": [
     2,
     "c1",
     "retail",
     8000
    ],
    "expect": "a1"
   },
   {
    "call": "capture",
    "args": [
     3,
     "a1",
     6000
    ],
    "expect": true
   },
   {
    "call": "refund",
    "args": [
     5,
     "a1",
     2500
    ],
    "expect": true
