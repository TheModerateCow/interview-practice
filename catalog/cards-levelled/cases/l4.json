 {
  "name": "frozen_card_rules",
  "steps": [
   {
    "new": "Issuer",
    "args": []
   },
   {
    "call": "issue_card",
    "args": [
     1,
     "c1",
     9000
    ],
    "expect": true
   },
   {
    "call": "freeze",
    "args": [
     1,
     "zz"
    ],
    "expect": false
   },
   {
    "call": "unfreeze",
    "args": [
     1,
     "c1"
    ],
    "expect": false
   },
   {
    "call": "authorize",
    "args": [
     2,
     "c1",
     "retail",
     1000
    ],
    "expect": "a1"
   },
   {
    "call": "authorize",
    "args": [
     2,
     "c1",
     "retail",
     2000
    ],
    "expect": "a2"
   },
   {
    "call": "authorize",
    "args": [
     2,
     "c1",
     "retail",
     3000
    ],
    "expect": "a3"
   },
   {
    "call": "freeze",
    "args": [
     3,
     "c1"
    ],
    "expect": true
   },
   {
    "call": "freeze",
    "args": [
     3,
     "c1"
    ],
    "expect": false
   },
   {
    "call": "authorize",
    "args": [
     3,
     "c1",
     "retail",
     10
    ],
    "expect": ""
   },
   {
    "call": "capture",
    "args": [
     3,
     "a1",
     1000
    ],
    "expect": true
   },
   {
    "call": "void_auth",
    "args": [
     3,
     "a2"
    ],
    "expect": true
   },
   {
    "call": "refund",
    "args": [
     4,
     "a1",
     400
    ],
    "expect": true
   },
   {
    "call": "available",
    "args": [
     4,
     "c1"
    ],
    "expect": 5400
   },
   {
    "call": "holds",
    "args": [
     9,
     "c1"
    ],
    "expect": []
   },
   {
    "call": "statement",
    "args": [
     9,
     "c1"
    ],
    "expect": [
     "3:a1:charge:1000",
     "4:a1:refund:400"
    ]
   },
   {
    "call": "unfreeze",
    "args": [
     9,
     "c1"
    ],
    "expect": true
   },
   {
    "call": "authorize",
    "args": [
     9,
     "c1",
     "retail",
     10
    ],
    "expect": "a4"
   }
  ]
