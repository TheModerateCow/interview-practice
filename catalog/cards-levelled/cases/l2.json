[
 {
  "name": "holds_expire",
  "steps": [
   {
    "new": "Issuer",
    "args": []
   },
   {
    "call": "issue_card",
    "args": [
     1,
     "c1",
     10000
    ],
    "expect": true
   },
   {
    "call": "authorize",
    "args": [
     1,
     "c1",
     "hotel",
     2000
    ],
    "expect": "a1"
   },
   {
    "call": "authorize",
    "args": [
     3,
     "c1",
     "fuel",
     5000
    ],
    "expect": "a2"
   },
   {
    "call": "holds",
    "args": [
     4,
     "c1"
    ],
    "expect": [
     "a1:2000",
     "a2:5000"
    ]
   },
   {
    "call": "available",
    "args": [
     7,
     "c1"
    ],
    "expect": 3000
   },
   {
    "call": "available",
    "args": [
     8,
     "c1"
    ],
    "expect": 5000
   },
   {
    "call": "holds",
    "args": [
     8,
     "c1"
    ],
    "expect": [
     "a2:5000"
    ]
   },
   {
    "call": "auth_status",
    "args": [
     8,
     "a1"
    ],
    "expect": "expired"
   },
   {
    "call": "capture",
    "args": [
     8,
     "a1",
     2000
    ],
    "expect": false
   },
   {
    "call": "auth_status",
    "args": [
     9,
     "a2"
    ],
    "expect": "open"
   }
  ]
 },
 {
