[
 {
  "name": "orders_example",
  "steps": [
   {
    "new": "Wallets",
    "args": []
   },
   {
    "call": "open_wallet",
    "args": [
     1,
     "ana"
    ],
    "expect": true
   },
   {
    "call": "deposit",
    "args": [
     2,
     "ana",
     "USD",
     5000
    ],
    "expect": 5000
   },
   {
    "call": "set_rate",
    "args": [
     3,
     "USD",
     "EUR",
     900000
    ],
    "expect": true
   },
   {
    "call": "place_order",
    "args": [
     4,
     "ana",
     "USD",
     "EUR",
     2000,
     950000
    ],
    "expect": "o1"
   },
   {
    "call": "place_order",
    "args": [
     5,
     "ana",
     "USD",
     "EUR",
     4000,
     920000
    ],
    "expect": "o2"
   },
   {
    "call": "set_rate",
    "args": [
     6,
     "USD",
     "EUR",
     960000
    ],
    "expect": true
   },
   {
    "call": "order_status",
    "args": [
     7,
     "o1"
    ],
    "expect": "filled:1901"
   },
   {
    "call": "order_status",
    "args": [
     8,
     "o2"
    ],
    "expect": "cancelled"
   },
   {
    "call": "balance",
    "args": [
     9,
     "ana",
     "EUR"
    ],
    "expect": 1901
   },
   {
    "call": "cancel_order",
    "args": [
     10,
     "o1"
    ],
    "expect": false
   }
  ]
 },
