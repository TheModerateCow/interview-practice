[
 {
  "name": "wallet_basics",
  "steps": [
   {
    "new": "Wallets",
    "args": []
   },
   {
    "call": "open_wallet",
    "args": [
     1,
     "ana"
    ],
    "expect": true
   },
   {
    "call": "open_wallet",
    "args": [
     2,
     "ana"
    ],
    "expect": false
   },
   {
    "call": "deposit",
    "args": [
     3,
     "ana",
     "USD",
     5000
    ],
    "expect": 5000
   },
   {
    "call": "deposit",
    "args": [
     4,
     "ana",
     "EUR",
     1200
    ],
    "expect": 1200
   },
   {
    "call": "withdraw",
    "args": [
     5,
     "ana",
     "USD",
     1500
    ],
    "expect": 3500
   },
   {
    "call": "withdraw",
    "args": [
     6,
     "ana",
     "EUR",
     2000
    ],
    "expect": -1
   },
   {
    "call": "balance",
    "args": [
     7,
     "ana",
     "GBP"
    ],
    "expect": 0
   },
   {
    "call": "holdings",
    "args": [
     8,
     "ana"
    ],
    "expect": [
     "EUR:1200",
     "USD:3500"
    ]
   },
   {
    "call": "balance",
    "args": [
     9,
     "bob",
     "USD"
    ],
    "expect": -1
   }
  ]
 },
