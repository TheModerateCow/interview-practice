  {"call": "add_order", "args": ["A1", 10, 4], "expect": true},
  {"call": "depth_at", "args": [10], "expect": 4},
  {"call": "cancel_order", "args": ["a1"], "expect": false},
  {"call": "cancel_order", "args": ["A1"], "expect": true},
  {"call": "best_ask", "args": [], "expect": null}
 ]},
