 {
  "name": "waiting_transitions",
  "steps": [
   {
    "new": "Desk",
    "args": []
   },
   {
    "call": "add_agent",
    "args": [
     1,
     "maya"
    ],
    "expect": true
   },
   {
    "call": "add_agent",
    "args": [
     1,
     "leo"
    ],
    "expect": true
   },
   {
    "call": "open_ticket",
    "args": [
     2,
     "acme",
     "normal"
    ],
    "expect": "t1"
   },
   {
    "call": "set_status",
    "args": [
     3,
     "t1",
     "waiting"
    ],
    "expect": false
   },
   {
    "call": "assign",
    "args": [
     4,
     "t1",
     "maya"
    ],
    "expect": true
   },
   {
    "call": "set_status",
    "args": [
     5,
     "t1",
     "in_progress"
    ],
    "expect": true
   },
   {
    "call": "set_status",
    "args": [
     6,
     "t1",
     "waiting"
    ],
    "expect": true
   },
   {
    "call": "set_status",
    "args": [
     7,
     "t1",
     "waiting"
    ],
    "expect": false
   },
   {
    "call": "set_status",
    "args": [
     8,
     "t1",
     "resolved"
    ],
    "expect": false
   },
   {
    "call": "set_status",
    "args": [
     9,
     "t1",
     "open"
    ],
    "expect": false
   },
   {
    "call": "get_ticket",
    "args": [
     10,
     "t1"
    ],
    "expect": "acme:normal:waiting:maya"
   },
   {
    "call": "assign",
    "args": [
     11,
     "t1",
     "leo"
    ],
    "expect": true
   },
   {
    "call": "queue",
    "args": [
     12,
     "leo"
    ],
    "expect": [
     "t1"
    ]
   },
   {
    "call": "open_ticket",
    "args": [
     13,
     "globex",
     "normal"
    ],
    "expect": "t2"
   },
   {
    "call": "auto_assign",
    "args": [
     14,
     "t2"
    ],
    "expect": "maya"
   },
   {
    "call": "set_status",
    "args": [
     15,
     "t1",
     "in_progress"
    ],
    "expect": true
   },
   {
    "call": "get_ticket",
    "args": [
     16,
     "t1"
    ],
    "expect": "acme:normal:in_progress:leo"
   }
  ]
 },
