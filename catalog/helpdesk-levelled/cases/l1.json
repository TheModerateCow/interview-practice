[
 {
  "name": "example_ticket_lifecycle",
  "steps": [
   {
    "new": "Desk",
    "args": []
   },
   {
    "call": "add_agent",
    "args": [
     1,
     "maya"
    ],
    "expect": true
   },
   {
    "call": "open_ticket",
    "args": [
     2,
     "acme",
     "high"
    ],
    "expect": "t1"
   },
   {
    "call": "open_ticket",
    "args": [
     3,
     "globex",
     "urgent"
    ],
    "expect": ""
   },
   {
    "call": "set_status",
    "args": [
     4,
     "t1",
     "in_progress"
    ],
    "expect": false
   },
   {
    "call": "assign",
    "args": [
     5,
     "t1",
     "maya"
    ],
    "expect": true
   },
   {
    "call": "set_status",
    "args": [
     6,
     "t1",
     "in_progress"
    ],
    "expect": true
   },
   {
    "call": "open_ticket",
    "args": [
     7,
     "initech",
     "low"
    ],
    "expect": "t2"
   },
   {
    "call": "set_status",
    "args": [
     8,
     "t2",
     "resolved"
    ],
    "expect": false
   },
   {
    "call": "set_status",
    "args": [
     9,
     "t1",
     "resolved"
    ],
    "expect": true
   },
   {
    "call": "get_ticket",
    "args": [
     10,
     "t1"
    ],
    "expect": "acme:high:resolved:maya"
   }
  ]
 },
