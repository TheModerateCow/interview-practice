[
 {
  "name": "example_shift_change",
  "steps": [
   {
    "new": "Desk",
    "args": []
   },
   {
    "call": "add_agent",
    "args": [
     0,
     "maya"
    ],
    "expect": true
   },
   {
    "call": "add_agent",
    "args": [
     0,
     "leo"
    ],
    "expect": true
   },
   {
    "call": "add_agent",
    "args": [
     0,
     "zoe"
    ],
    "expect": true
   },
   {
    "call": "open_ticket",
    "args": [
     1,
     "acme",
     "low"
    ],
    "expect": "t1"
   },
   {
    "call": "open_ticket",
    "args": [
     2,
     "globex",
     "high"
    ],
    "expect": "t2"
   },
   {
    "call": "open_ticket",
    "args": [
     3,
     "initech",
     "normal"
    ],
    "expect": "t3"
   },
   {
    "call": "assign",
    "args": [
     4,
     "t1",
     "maya"
    ],
    "expect": true
   },
   {
    "call": "assign",
    "args": [
     4,
     "t2",
     "maya"
    ],
    "expect": true
   },
   {
    "call": "assign",
    "args": [
     4,
     "t3",
     "maya"
    ],
    "expect": true
   },
   {
    "call": "set_status",
    "args": [
     4,
     "t2",
     "in_progress"
    ],
    "expect": true
   },
   {
    "call": "open_ticket",
    "args": [
     5,
     "umbrella",
     "low"
    ],
    "expect": "t4"
   },
   {
    "call": "assign",
    "args": [
     5,
     "t4",
     "leo"
    ],
    "expect": true
   },
   {
    "call": "end_shift",
    "args": [
     6,
     "maya"
    ],
    "expect": [
     "t2:zoe",
     "t3:leo",
     "t1:zoe"
    ]
   },
   {
    "call": "assign",
    "args": [
     7,
     "t4",
     "maya"
    ],
    "expect": false
   },
   {
    "call": "history",
    "args": [
     8,
     "t2"
    ],
    "expect": [
     "2:opened",
     "4:assigned:maya",
     "4:in_progress",
     "6:assigned:zoe"
    ]
   }
  ]
 },
