    "args": [
     9,
     "svc-api",
     "zz"
    ],
    "expect": []
   },
   {
    "call": "scan_prefix",
    "args": [
     10,
     "svc-api",
     ""
    ],
    "expect": [
     "env=prod",
     "env.HOST=0.0.0.0",
     "env.PORT=8080",
     "envoy=on",
     "image=v1"
    ]
   },
   {
    "call": "scan",
    "args": [
     11,
     "svc-api"
    ],
    "expect": [
     "env=prod",
     "env.HOST=0.0.0.0",
     "env.PORT=8080",
     "envoy=on",
     "image=v1"
    ]
   },
   {
    "call": "scan_prefix",
    "args": [
     12,
     "svc-web",
     "env"
    ],
    "expect": []
   }
  ]
 },
