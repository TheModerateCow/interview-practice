 {
  "name": "expired_hidden_from_scans",
  "steps": [
   {
    "new": "Store",
    "args": []
   },
   {
    "call": "set",
    "args": [
     1,
     "svc-api",
     "image",
     "v1"
    ]
   },
   {
    "call": "set_with_ttl",
    "args": [
     2,
     "svc-api",
     "canary",
     "on",
     5
    ]
   },
   {
    "call": "set_with_ttl",
    "args": [
     3,
     "svc-api",
     "env.DEBUG",
     "1",
     10
    ]
   },
   {
    "call": "set",
    "args": [
     4,
     "svc-api",
     "env.PORT",
     "80"
    ]
   },
   {
    "call": "scan",
    "args": [
     5,
     "svc-api"
    ],
    "expect": [
     "canary=on",
     "env.DEBUG=1",
     "env.PORT=80",
     "image=v1"
    ]
   },
   {
    "call": "scan",
    "args": [
     7,
     "svc-api"
    ],
    "expect": [
     "env.DEBUG=1",
     "env.PORT=80",
     "image=v1"
    ]
   },
   {
    "call": "scan_prefix",
    "args": [
     12,
     "svc-api",
     "env."
    ],
    "expect": [
     "env.DEBUG=1",
     "env.PORT=80"
    ]
   },
   {
    "call": "scan_prefix",
    "args": [
     13,
     "svc-api",
     "env."
    ],
    "expect": [
     "env.PORT=80"
    ]
   }
  ]
 },
