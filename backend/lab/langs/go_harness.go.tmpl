func hiddenGoName(s string) string {
	parts := strings.Split(s, "_")
	for i, p := range parts {
		if hiddenInit[p] {
			parts[i] = strings.ToUpper(p)
		} else if p != "" {
			parts[i] = strings.ToUpper(p[:1]) + p[1:]
		}
	}
	return strings.Join(parts, "")
}

