// hiddenFrom converts decoded JSON into a value of Go type t.
func hiddenFrom(v any, t reflect.Type) (reflect.Value, error) {
	out := reflect.New(t).Elem()
	if v == nil {
		return out, nil
	}
	switch t.Kind() {
	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
		n, ok := v.(json.Number)
		if !ok {
			return out, fmt.Errorf("expected a number for %s", t)
		}
		i, err := n.Int64()
		if err != nil {
			return out, err
		}
		out.SetInt(i)
	case reflect.Bool:
		b, ok := v.(bool)
		if !ok {
			return out, fmt.Errorf("expected a bool for %s", t)
		}
		out.SetBool(b)
	case reflect.String:
		s, ok := v.(string)
		if !ok {
			return out, fmt.Errorf("expected a string for %s", t)
		}
		out.SetString(s)
	case reflect.Slice:
		arr, ok := v.([]any)
		if !ok {
			return out, fmt.Errorf("expected an array for %s", t)
		}
		out.Set(reflect.MakeSlice(t, len(arr), len(arr)))
		for i, x := range arr {
			e, err := hiddenFrom(x, t.Elem())
			if err != nil {
				return out, err
			}
			out.Index(i).Set(e)
		}
	case reflect.Struct:
		obj, ok := v.(map[string]any)
		if !ok {
			return out, fmt.Errorf("expected an object for %s", t)
		}
		for k, x := range obj {
			f := out.FieldByName(hiddenGoName(k))
			if !f.IsValid() {
				return out, fmt.Errorf("type %s has no field %s", t, hiddenGoName(k))
			}
			e, err := hiddenFrom(x, f.Type())
			if err != nil {
				return out, err
			}
			f.Set(e)
		}
	default:
		return out, fmt.Errorf("unsupported type %s", t)
	}
	return out, nil
}

// hiddenTo converts a Go value into its JSON form (neutral field names, nil slice = []).
func hiddenTo(v reflect.Value) any {
	switch v.Kind() {
	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
		return v.Int()
	case reflect.Bool:
		return v.Bool()
	case reflect.String:
		return v.String()
	case reflect.Slice, reflect.Array:
		out := make([]any, v.Len())
		for i := range out {
			out[i] = hiddenTo(v.Index(i))
		}
		return out
	case reflect.Pointer, reflect.Interface:
		if v.IsNil() {
			return nil
		}
		return hiddenTo(v.Elem())
	case reflect.Struct:
		m := map[string]any{}
		t := v.Type()
		fields, known := hiddenAPI.Records[t.Name()]
		for i := 0; i < t.NumField(); i++ {
			if !t.Field(i).IsExported() {
				continue
			}
			key := t.Field(i).Name
			if known {
				key = ""
				for _, f := range fields {
					if hiddenGoName(f[0]) == t.Field(i).Name {
						key = f[0]
					}
				}
				if key == "" {
					continue
				}
			}
			m[key] = hiddenTo(v.Field(i))
		}
		return m
	}
	return fmt.Sprint(v.Interface())
}

func hiddenCallText(name string, args []json.RawMessage) string {
	parts := make([]string, len(args))
	for i, a := range args {
		v, _ := hiddenDecode(a)
		parts[i] = hiddenJSON(v)
		if len(parts[i]) > 200 {
			parts[i] = parts[i][:200] + "..."
		}
	}
	return name + "(" + strings.Join(parts, ", ") + ")"
}

// hiddenApply calls f with JSON args; msg is a harness-level failure (bad signature, panic).
func hiddenApply(f reflect.Value, raw []json.RawMessage) (outs []reflect.Value, dur time.Duration, msg string) {
	ft := f.Type()
	if ft.NumIn() != len(raw) {
		return nil, 0, fmt.Sprintf("expected %d parameters, your function takes %d", len(raw), ft.NumIn())
	}
	ins := make([]reflect.Value, len(raw))
	for i, a := range raw {
		v, err := hiddenDecode(a)
		if err == nil {
			ins[i], err = hiddenFrom(v, ft.In(i))
		}
		if err != nil {
			return nil, 0, fmt.Sprintf("argument %d: %v", i+1, err)
		}
	}
	defer func() {
		if r := recover(); r != nil {
			msg = fmt.Sprint("panic: ", r)
		}
	}()
	start := time.Now()
	outs = f.Call(ins)
	return outs, time.Since(start), ""
}

func hiddenResultOf(outs []reflect.Value, sig hiddenSig) (r hiddenResult, msg string) {
	if sig.Errors {
		if len(outs) == 0 {
			return r, "expected an error result"
		}
		last := outs[len(outs)-1]
		outs = outs[:len(outs)-1]
		if e, _ := last.Interface().(error); e != nil {
			r.err = e
		}
	}
	switch {
	case strings.HasPrefix(sig.Returns, "optional<"):
		if len(outs) != 2 {
			return r, fmt.Sprintf("expected (value, bool) results, got %d results", len(outs))
		}
		if outs[1].Kind() == reflect.Bool && outs[1].Bool() {
			r.val = hiddenTo(outs[0])
		}
	case sig.Returns != "":
		if len(outs) != 1 {
			return r, fmt.Sprintf("expected 1 result, got %d", len(outs))
		}
		r.val = hiddenTo(outs[0])
	default:
		if len(outs) != 0 {
			return r, fmt.Sprintf("expected no result, got %d", len(outs))
		}
	}
	return r, ""
}

func hiddenShow(r hiddenResult, sig hiddenSig) string {
	if r.err != nil {
		return fmt.Sprintf("error %q", r.err.Error())
	}
	if sig.Returns == "" {
		return "no error"
	}
	return hiddenJSON(r.val)
}

// hiddenCompare returns "" when the result matches what the case expects.
func hiddenCompare(c hiddenCase, expect json.RawMessage, r hiddenResult, sig hiddenSig) string {
	wantErr := len(c.Error) > 0 && string(c.Error) != "false"
	got := hiddenShow(r, sig)
	if wantErr {
		kind := ""
		if err := json.Unmarshal(c.Error, &kind); err != nil {
			kind = "" // true: any error
		}
		switch {
		case r.err == nil && kind == "":
			return "expected an error, got " + got
		case r.err == nil:
			return "expected error " + kind + ", got " + got
		case kind != "" && !errors.Is(r.err, hiddenErrs[kind]):
			return "expected error " + kind + ", got " + got
		}
		return ""
	}
	if r.err != nil {
		want := "no error"
		if len(expect) > 0 {
			v, _ := hiddenDecode(expect)
			want = hiddenJSON(v)
		}
		return "expected " + want + ", got " + got
	}
	if len(expect) > 0 {
		v, _ := hiddenDecode(expect)
		if hiddenJSON(v) != got {
			return "expected " + hiddenJSON(v) + ", got " + got
		}
	}
	return ""
}

// hiddenArgs resolves a case's arguments and expectation (the "data" file, when given).
func hiddenArgs(c hiddenCase) ([]json.RawMessage, json.RawMessage) {
	if c.Data == "" {
		return c.Args, c.Expect
	}
	var d struct {
		Args   []json.RawMessage `json:"args"`
		Expect json.RawMessage   `json:"expect"`
	}
	if err := json.Unmarshal([]byte(hiddenDataJSON[c.Data]), &d); err != nil {
		panic(err)
	}
	if len(c.Expect) > 0 {
		d.Expect = c.Expect
	}
	return d.Args, d.Expect
}

func hiddenExec(c hiddenCase) string {
	steps, single := c.Steps, false
	if len(steps) == 0 {
		steps, single = []hiddenCase{c}, true
	}
	var obj reflect.Value
	var class string
	var dur time.Duration
	start := time.Now()
	for i, s := range steps {
		label := ""
		if !single {
			label = fmt.Sprintf("step %d ", i+1)
		}
		args, expect := hiddenArgs(s)
		if s.New != "" {
			text := label + hiddenCallText("New"+s.New, args)
			outs, _, msg := hiddenApply(reflect.ValueOf(hiddenNew[s.New]), args)
			if msg != "" {
				return text + ": " + msg
			}
			wantN := 1
			if hiddenAPI.Classes[s.New].InitErrors {
				wantN = 2
			}
			if len(outs) != wantN {
				return fmt.Sprintf("%s: expected %d results, got %d", text, wantN, len(outs))
			}
			if wantN == 2 {
				var r hiddenResult
				if e, _ := outs[1].Interface().(error); e != nil {
					r.err = e
				}
				if m := hiddenCompare(s, nil, r, hiddenSig{Errors: true}); m != "" {
					return text + ": " + m
				}
				if r.err != nil {
					break // a failed new leaves no object: the case ends here
				}
			} else if len(s.Error) > 0 && string(s.Error) != "false" {
				return text + ": the class does not declare init_errors in api.json"
			}
			obj, class = outs[0], s.New
			continue
		}
		var f reflect.Value
		var sig hiddenSig
		name := hiddenGoName(s.Call)
		if fn, ok := hiddenFuncs[s.Call]; ok {
			f, sig = reflect.ValueOf(fn), hiddenAPI.Functions[s.Call]
		} else {
			if !obj.IsValid() {
				return label + hiddenCallText(name, args) + ": no object (the case has no new step)"
			}
			f, sig = obj.MethodByName(name), hiddenAPI.Classes[class].Methods[s.Call]
			if !f.IsValid() {
				return label + hiddenCallText(name, args) + ": method " + name + " not found on " + class
			}
		}
		text := label + hiddenCallText(name, args)
		outs, d, msg := hiddenApply(f, args)
		if msg != "" {
			return text + ": " + msg
		}
		dur += d
		r, msg := hiddenResultOf(outs, sig)
		if msg != "" {
			return text + ": " + msg
		}
		if m := hiddenCompare(s, expect, r, sig); m != "" {
			return text + ": " + m
		}
	}
	if b, ok := c.BudgetMS["go"]; ok {
		if !single {
			dur = time.Since(start)
		}
		if dur.Milliseconds() > int64(b) {
			return fmt.Sprintf("%s took %d ms, budget %d ms", c.Name, dur.Milliseconds(), b)
		}
	}
	return ""
}

func hiddenRun(t *testing.T, name string) {
	t.Helper()
	if msg := hiddenExec(hiddenByName[name]); msg != "" {
		t.Fatal(msg)
	}
}

